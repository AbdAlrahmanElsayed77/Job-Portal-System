@model BL.Dtos.JobPostDto

@{
    ViewData["Title"] = "Delete Job Post";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .delete-container {
        padding: 2rem;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .delete-wrapper {
        max-width: 600px;
        width: 100%;
    }

    .delete-card {
        background: white;
        border-radius: 16px;
        padding: 3rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
        border: 2px solid #dc3545;
    }

    .delete-icon {
        font-size: 4rem;
        text-align: center;
        margin-bottom: 1.5rem;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.7;
    }

    }

    .delete-header h1 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #dc3545;
        margin-bottom: 0.5rem;
        text-align: center;
    }

    .delete-header p {
        font-size: 1rem;
        color: #666;
        text-align: center;
        margin: 0;
    }

    .delete-content {
        margin: 2rem 0;
        padding: 1.5rem;
        background: linear-gradient(135deg, #fff5f5 0%, #ffe0e0 100%);
        border-radius: 12px;
        border-left: 4px solid #dc3545;
    }

    .job-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 1rem;
    }

    .job-description {
        color: #666;
        line-height: 1.6;
        white-space: pre-wrap;
        word-wrap: break-word;
        font-size: 0.95rem;
    }

    .delete-warning {
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        border-radius: 8px;
        padding: 1rem;
        margin: 1.5rem 0;
        color: #721c24;
        font-weight: 500;
    }

    .warning-icon {
        margin-right: 0.5rem;
    }

    .delete-info {
        background-color: #e7f3ff;
        border: 1px solid #b3d9ff;
        border-radius: 8px;
        padding: 1rem;
        margin: 1.5rem 0;
        color: #004085;
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .delete-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .btn {
        padding: 1rem 2rem;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        flex: 1;
    }

    .btn-danger {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
    }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(220, 53, 69, 0.3);
            color: white;
            text-decoration: none;
        }

        .btn-danger:active {
            transform: translateY(0);
        }

    .btn-secondary {
        background-color: #e9ecef;
        color: #333;
    }

        .btn-secondary:hover {
            background-color: #dee2e6;
            text-decoration: none;
        }

    .confirmation-message {
        text-align: center;
        margin-bottom: 2rem;
        padding: 1rem;
        background-color: #f8f9fa;
        border-radius: 8px;
    }

        .confirmation-message p {
            margin: 0;
            color: #666;
            font-size: 0.95rem;
        }

        .confirmation-message strong {
            color: #dc3545;
        }

    @@media (max-width: 768px) {
        .delete-container

    {
        padding: 1rem;
    }

    .delete-card {
        padding: 2rem;
    }

    .delete-header h1 {
        font-size: 1.5rem;
    }

    .delete-icon {
        font-size: 3rem;
    }

    .delete-actions {
        flex-direction: column;
    }

    .btn {
        width: 100%;
        padding: 0.85rem 1rem;
    }

    .delete-content {
        padding: 1rem;
    }

    .job-title {
        font-size: 1.1rem;
    }

    .job-description {
        font-size: 0.9rem;
    }

    }

    @@media (max-width: 480px) {
        .delete-card

    {
        padding: 1.5rem;
        border-radius: 12px;
    }

    .delete-icon {
        font-size: 2.5rem;
    }

    .delete-header h1 {
        font-size: 1.3rem;
    }

    .btn {
        padding: 0.75rem 1rem;
        font-size: 0.9rem;
    }

    }
</style>

<div class="delete-container">
    <div class="delete-wrapper">
        <div class="delete-card">
            <!-- Delete Icon -->
            <div class="delete-icon">⚠️</div>

            <!-- Header -->
            <div class="delete-header">
                <h1>Delete Job Post?</h1>
                <p>This action cannot be undone</p>
            </div>

            <!-- Confirmation Message -->
            <div class="confirmation-message">
                <p>You are about to permanently delete this job posting. <strong>All associated applications will also be affected.</strong></p>
            </div>

            <!-- Job Details -->
            <div class="delete-content">
                <div class="job-title">@Model.Title</div>
                <div class="job-description">@Model.Description</div>
            </div>

            <!-- Warning Alert -->
            <div class="delete-warning">
                <span class="warning-icon">🔴</span>
                <strong>Warning:</strong> This is a permanent action and cannot be reversed.
            </div>

            <!-- Info Alert -->
            <div class="delete-info">
                <strong>ℹ️ Note:</strong> Deleting this job post will remove all associated applications and applicant data from the system permanently. Please ensure you have backed up any important information before proceeding.
            </div>

            <!-- Action Buttons -->
            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="delete-actions">
                    <a asp-action="JobPosts" class="btn btn-secondary">← Cancel</a>
                    <button type="submit" class="btn btn-danger">🗑️ Delete Permanently</button>
                </div>
            </form>
        </div>
    </div>
</div>