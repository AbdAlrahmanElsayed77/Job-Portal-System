@using Domains
@model IEnumerable<BL.Dtos.ApplicationDto>

@{
    ViewData["Title"] = "Applicants for " + ViewBag.JobTitle;
    var id = ViewBag.JobPostId;
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .applicants-container {
        padding: 2rem;
        /* background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); */
        min-height: 100vh;
    }

    .applicants-wrapper {
        max-width: 1200px;
        margin: 0 auto;
    }

    .applicants-header {
        background: white;
        border-radius: 16px;
        padding: 2.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .header-left h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 0.5rem;
    }

    .header-stats {
        display: flex;
        gap: 1.5rem;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .stat-badge {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.95rem;
    }

    .stat-label {
        color: #666;
        font-size: 0.9rem;
        text-transform: uppercase;
        font-weight: 600;
    }

    .header-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
            color: white;
            text-decoration: none;
        }

    .btn-secondary {
        background-color: #e9ecef;
        color: #333;
    }

        .btn-secondary:hover {
            background-color: #dee2e6;
            text-decoration: none;
        }

    .btn-success {
        background-color: #28a745;
        color: white;
    }

        .btn-success:hover {
            background-color: #218838;
            text-decoration: none;
        }

    .btn-danger {
        background-color: #dc3545;
        color: white;
    }

        .btn-danger:hover {
            background-color: #c82333;
            text-decoration: none;
        }

    .btn-download {
        background-color: #0d6efd;
        color: white;
        font-size: 0.85rem;
        padding: 0.5rem 1rem;
    }

        .btn-download:hover {
            background-color: #0b5ed7;
        }

    .btn-update {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        font-size: 0.85rem;
        padding: 0.5rem 1rem;
    }

        .btn-update:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }

    .applicants-table-container {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        margin-bottom: 2rem;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .table thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

            .table thead th {
                padding: 1.25rem;
                font-weight: 700;
                text-align: left;
                font-size: 0.95rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

        .table tbody tr {
            border-bottom: 1px solid #e0e0e0;
            transition: all 0.3s ease;
        }

            .table tbody tr:hover {
                background-color: #f8f9fa;
            }

            .table tbody tr:last-child {
                border-bottom: none;
            }

        .table tbody td {
            padding: 1.25rem;
            color: #333;
            font-size: 0.95rem;
        }

    .applicant-name {
        font-weight: 600;
        color: #1a1a1a;
    }

    .status-badge {
        display: inline-block;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .status-pending {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-approved {
        background-color: #d4edda;
        color: #155724;
    }

    .status-rejected {
        background-color: #f8d7da;
        color: #721c24;
    }

    .status-shortlisted {
        background-color: #cfe2ff;
        color: #084298;
    }

    .cover-letter-text {
        color: #666;
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .cover-letter-text.empty {
            color: #999;
            font-style: italic;
        }

    .status-update-form {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .form-select {
        padding: 0.5rem;
        border: 2px solid #e0e0e0;
        border-radius: 6px;
        font-size: 0.9rem;
        background-color: white;
        color: #333;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .form-select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    .empty-state {
        padding: 3rem;
        text-align: center;
        color: #666;
    }

    .empty-state-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .empty-state h3 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
        color: #1a1a1a;
    }

    .footer-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

        .footer-actions .btn {
            flex: 1;
            min-width: 150px;
            justify-content: center;
        }

    @@media (max-width: 1024px) {
        .header-actions

    {
        justify-content: flex-start;
    }

    .table thead th {
        padding: 1rem 0.75rem;
        font-size: 0.85rem;
    }

    .table tbody td {
        padding: 1rem 0.75rem;
        font-size: 0.85rem;
    }

    }

    @@media (max-width: 768px) {
        .applicants-container

    {
        padding: 1rem;
    }

    .applicants-header {
        padding: 1.5rem;
    }

    .header-content {
        flex-direction: column;
        align-items: flex-start;
    }

    .header-left h1 {
        font-size: 1.5rem;
    }

    .header-actions {
        width: 100%;
        justify-content: flex-start;
    }

    .header-stats {
        flex-direction: column;
        gap: 1rem;
    }

    .stat-item {
        width: 100%;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .table {
        font-size: 0.85rem;
    }

        .table thead th,
        .table tbody td {
            padding: 0.75rem 0.5rem;
        }

    .status-update-form {
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-select {
        width: 100%;
    }

    .btn-update {
        width: 100%;
    }

    .cover-letter-text {
        max-width: 100px;
    }

    .footer-actions {
        flex-direction: column;
    }

        .footer-actions .btn {
            width: 100%;
        }

    }

    @@media (max-width: 480px) {
        .table

    {
        font-size: 0.75rem;
    }

    .table thead th,
    .table tbody td {
        padding: 0.5rem;
    }

    .btn {
        padding: 0.5rem 0.75rem;
        font-size: 0.8rem;
    }

    .status-badge {
        font-size: 0.7rem;
        padding: 0.3rem 0.6rem;
    }

    }
</style>

<div class="applicants-container">
    <div class="applicants-wrapper">
        <!-- Header Section -->
        <div class="applicants-header">
            <div class="header-content">
                <div class="header-left">
                    <h1>👥 Applicants</h1>
                    <p style="color: #666; margin: 0; font-size: 1.1rem;">@ViewBag.JobTitle</p>
                    <div class="header-stats">
                        <div class="stat-item">
                            <span class="stat-label">Total Applications:</span>
                            <span class="stat-badge">@Model.Count()</span>
                        </div>
                    </div>
                </div>
                <div class="header-actions">
                    <a asp-controller="Employer" asp-action="Details" asp-route-id="@id" class="btn btn-secondary">← Back to Job</a>
                </div>
            </div>
        </div>

        <!-- Applicants Table -->
        @if (Model.Any())
        {
            <div class="applicants-table-container">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Applicant Name</th>
                                <th>Status</th>
                                <th>Applied At</th>
                                <th>Cover Letter</th>
                                <th>CV</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model)
                            {
                                <tr>
                                    <td class="applicant-name">@app.ApplicantName</td>
                                    <td>
                                        <span class="status-badge status-@app.Status.ToString().ToLower()">
                                            @app.Status
                                        </span>
                                    </td>
                                    <td>@app.AppliedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <span class="cover-letter-text @(string.IsNullOrWhiteSpace(app.CoverLetter) ? "empty" : "")">
                                            @(string.IsNullOrWhiteSpace(app.CoverLetter) ? "No cover letter" : app.CoverLetter.Substring(0, Math.Min(50, app.CoverLetter.Length)) + (app.CoverLetter.Length > 50 ? "..." : ""))
                                        </span>
                                    </td>
                                    <td>
                                        @if (app.CVFileId != null)
                                        {
                                            <a asp-action="DownloadCV" asp-route-id="@app.CVFileId" class="btn btn-download">📥 Download</a>
                                        }
                                        else
                                        {
                                            <span style="color: #999; font-style: italic;">No CV</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="UpdateApplicationStatus" method="post" class="status-update-form">
                                            <input type="hidden" name="id" value="@app.Id" />
                                            <select name="status" class="form-select">
                                                @foreach (Status s in Enum.GetValues(typeof(Status)))
                                                {
                                                    <option value="@s" selected="@(s == app.Status)">@s</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-update">✓ Update</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="applicants-table-container">
                <div class="empty-state">
                    <div class="empty-state-icon">📋</div>
                    <h3>No Applicants Yet</h3>
                    <p>There are currently no applications for this job post.</p>
                </div>
            </div>
        }

        <!-- Footer Actions -->
        <div class="footer-actions">
            <a asp-controller="Employer" asp-action="JobPosts" class="btn btn-secondary">← Back to Job Posts</a>
            <a asp-action="ExportToExcel" asp-route-jobPostId="@ViewBag.JobPostId" class="btn btn-success">📊 Export to Excel</a>
            <a asp-action="ExportToPdf" asp-route-jobPostId="@ViewBag.JobPostId" class="btn btn-danger">📄 Export to PDF</a>
        </div>
    </div>
</div>