@model PortalSystemProject.Models.Home.HomeViewModel

@{
    ViewData["Title"] = "Find Your Dream Job";
}

<!-- Hero Section -->
<section class="hero-section bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <h1 class="display-4 fw-bold mb-3">Find Your Dream Job Today</h1>
                <p class="lead mb-4">
                    Thousands of jobs in computer engineering, marketing, sales, and more
                </p>
                <div class="d-flex gap-2">
                    <span class="badge bg-white text-primary fs-6 px-3 py-2">
                        <i class="bi bi-briefcase"></i> @Model.TotalJobs+ Jobs
                    </span>
                    <span class="badge bg-white text-primary fs-6 px-3 py-2">
                        <i class="bi bi-building"></i> @Model.TotalCompanies+ Companies
                    </span>
                </div>
            </div>
            <div class="col-lg-6">
                <!-- Search Box -->
                <div class="card shadow-lg border-0">
                    <div class="card-body p-4">
                        <h5 class="text-dark mb-3">
                            <i class="bi bi-search"></i> Search for Jobs
                        </h5>
                        <form asp-action="Search" method="get">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <input type="text"
                                           name="keyword"
                                           class="form-control form-control-lg"
                                           placeholder="Job title or keyword...">
                                </div>
                                <div class="col-md-6">
                                    <input type="text"
                                           name="location"
                                           class="form-control form-control-lg"
                                           placeholder="City or location...">
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary btn-lg w-100">
                                        <i class="bi bi-search"></i> Search Jobs
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Popular Categories -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Browse by Category</h2>
            <p class="text-muted">Explore jobs by your field of interest</p>
        </div>
        <div class="row g-3">
            @foreach (var category in Model.Categories.Take(8))
            {
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="JobSeeker"
                       asp-action="BrowseJobs"
                       asp-route-categoryId="@category.Id"
                       class="text-decoration-none">
                        <div class="card h-100 text-center shadow-sm hover-shadow">
                            <div class="card-body">
                                <div class="category-icon mb-3">
                                    <i class="bi bi-briefcase-fill fs-1 text-primary"></i>
                                </div>
                                <h6 class="fw-bold mb-2">@category.Name</h6>
                                <small class="text-muted">@category.JobCount positions</small>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-controller="JobSeeker" asp-action="BrowseJobs" class="btn btn-outline-primary">
                View All Categories
            </a>
        </div>
    </div>
</section>

<!-- Recently Posted Jobs -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold">Recently Posted Jobs</h2>
                <p class="text-muted">Fresh opportunities just for you</p>
            </div>
            <a asp-controller="JobSeeker" asp-action="BrowseJobs" class="btn btn-primary">
                View All Jobs
            </a>
        </div>

        @if (Model.RecentJobs.Any())
        {
            <div class="row g-4">
                @foreach (var job in Model.RecentJobs)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm hover-shadow">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="company-logo bg-light rounded p-2">
                                        <i class="bi bi-building fs-3 text-primary"></i>
                                    </div>
                                    <span class="badge bg-success">New</span>
                                </div>

                                <h5 class="card-title mb-2">
                                    <a asp-controller="JobSeeker"
                                       asp-action="JobDetails"
                                       asp-route-id="@job.Id"
                                       class="text-decoration-none text-dark">
                                        @job.Title
                                    </a>
                                </h5>

                                <p class="text-muted mb-3">
                                    <i class="bi bi-building"></i> @job.CompanyName
                                </p>

                                <div class="job-meta mb-3">
                                    @if (!string.IsNullOrEmpty(job.City))
                                    {
                                        <small class="d-block mb-1">
                                            <i class="bi bi-geo-alt text-primary"></i>
                                            @job.City, @job.Country
                                        </small>
                                    }
                                    @if (!string.IsNullOrEmpty(job.SalaryRange))
                                    {
                                        <small class="d-block mb-1">
                                            <i class="bi bi-currency-dollar text-success"></i>
                                            @job.SalaryRange
                                        </small>
                                    }
                                    <small class="text-muted d-block">
                                        <i class="bi bi-clock"></i>
                                        @job.PublishedAt.ToString("dd MMM yyyy")
                                    </small>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-primary">@job.Category</span>
                                    <a asp-controller="JobSeeker"
                                       asp-action="JobDetails"
                                       asp-route-id="@job.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle fs-1 d-block mb-3"></i>
                <h5>No jobs available at the moment</h5>
                <p>Check back soon for new opportunities!</p>
            </div>
        }
    </div>
</section>

<!-- How It Works -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">How It Works</h2>
            <p class="text-muted">Get hired in 3 easy steps</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="text-center">
                    <div class="step-icon bg-primary text-white rounded-circle mx-auto mb-3"
                         style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-search fs-1"></i>
                    </div>
                    <h5 class="fw-bold">1. Search Jobs</h5>
                    <p class="text-muted">Browse thousands of job opportunities</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center">
                    <div class="step-icon bg-primary text-white rounded-circle mx-auto mb-3"
                         style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-file-earmark-text fs-1"></i>
                    </div>
                    <h5 class="fw-bold">2. Upload CV</h5>
                    <p class="text-muted">Create your profile and upload your resume</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center">
                    <div class="step-icon bg-primary text-white rounded-circle mx-auto mb-3"
                         style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-send fs-1"></i>
                    </div>
                    <h5 class="fw-bold">3. Apply</h5>
                    <p class="text-muted">Submit your application with one click</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5 bg-primary text-white">
    <div class="container text-center">
        <h2 class="fw-bold mb-3">Ready to Find Your Next Opportunity?</h2>
        <p class="lead mb-4">Join thousands of job seekers finding their dream jobs</p>
        <div class="d-flex gap-3 justify-content-center">
            @if (!User.Identity!.IsAuthenticated)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg">
                    <i class="bi bi-person-plus"></i> Get Started
                </a>
            }
            <a asp-controller="JobSeeker" asp-action="BrowseJobs" class="btn btn-outline-light btn-lg">
                <i class="bi bi-search"></i> Browse Jobs
            </a>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .hero-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .hover-shadow {
            transition: all 0.3s ease;
        }

            .hover-shadow:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
            }

        .category-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f8f9fa;
            border-radius: 10px;
        }
    </style>
}