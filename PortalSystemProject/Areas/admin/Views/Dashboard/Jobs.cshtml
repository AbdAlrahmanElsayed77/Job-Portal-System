@using Domains
@model BL.Dtos.Common.PagedResultDto<Domains.JobPost>

@{
    ViewData["Title"] = "Jobs";
}

<h1>Jobs</h1>

<table class="table table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Company</th>
            <th>Category</th>
            <th>Job Type</th>
            <th>Posted Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model.Items)
        {
            <tr id="row-@job.Id">
                <td>@job.Title</td>
                <td>@job.Company?.Name ?? "N/A"</td>
                <td>@job.JobCategory?.Name ?? "N/A"</td>
                <td>@job.JobType?.Name ?? "N/A"</td>
                <td>@job.CreatedDate.ToString()</td>
                <td>
                    <div class="form-check form-switch">
                        <input class="form-check-input job-status-toggle"
                               type="checkbox"
                               role="switch"
                               data-id="@job.Id"
                               @(job.IsActive ? "checked" : "") />
                        <label class="form-check-label">
                            @(job.IsActive ? "Active" : "Inactive")
                        </label>
                    </div>
                </td>
                <td>
                    <a asp-area="admin" asp-controller="Dashboard" asp-action="Details" asp-route-id="@job.Id" class="btn btn-info btn-sm">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pagination", Model)

@section Scripts {
    <script>
        document.querySelectorAll(".job-status-toggle").forEach(toggle => {
            toggle.addEventListener("change", async (e) => {
                const jobId = e.target.getAttribute("data-id");
                const isActive = e.target.checked;

                try {
                    const response = await fetch(`/admin/Dashboard/ToggleJobStatus`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                        },
                        body: JSON.stringify({ id: jobId, isActive })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        e.target.nextElementSibling.textContent = data.isActive ? "Active" : "Inactive";
                        e.target.closest("tr").classList.toggle("table-secondary", !data.isActive);
                    } else {
                        alert("❌ Failed to update job status");
                    }
                } catch (err) {
                    console.error(err);
                    alert("⚠️ Error connecting to server");
                }
            });
        });
    </script>
}
