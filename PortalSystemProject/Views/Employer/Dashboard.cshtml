@{
    ViewData["Title"] = "Employer Dashboard";
    var data = ViewBag.DashboardData;
}

<h2 class="mb-4">Employer Dashboard</h2>

<div class="row text-center mb-4">
    <div class="col-md-2">
        <div class="card p-3 shadow-sm">
            <h5>Total Jobs</h5>
            <h3>@data.totalJobs</h3>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card p-3 shadow-sm">
            <h5>Total Applicants</h5>
            <h3>@data.totalApplicants</h3>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card p-3 shadow-sm">
            <h5>Accepted</h5>
            <h3>@data.acceptedCount</h3>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card p-3 shadow-sm">
            <h5>Rejected</h5>
            <h3>@data.rejectedCount</h3>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card p-3 shadow-sm">
            <h5>Active Jobs</h5>
            <h3>@data.activeJobs</h3>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card p-3 shadow-sm">
            <h5>Expired Jobs</h5>
            <h3>@data.expiredJobs</h3>
        </div>
    </div>
</div>

<hr />

<div class="row">
    <div class="col-md-6">
        <canvas id="statusChart"></canvas>
    </div>
    <div class="col-md-6">
        <canvas id="jobsChart"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const statusCtx = document.getElementById('statusChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'pie',
            data: {
                labels: ['Accepted', 'Rejected', 'Under Review'],
                datasets: [{
                    label: 'Application Status',
                    data: [@data.acceptedCount, @data.rejectedCount, @data.totalApplicants - (@data.acceptedCount + @data.rejectedCount)],
                    backgroundColor: ['#4caf50', '#f44336', '#ffeb3b']
                }]
            }
        });

        const jobsCtx = document.getElementById('jobsChart').getContext('2d');
        new Chart(jobsCtx, {
            type: 'doughnut',
            data: {
                labels: ['Active Jobs', 'Expired Jobs'],
                datasets: [{
                    label: 'Jobs Overview',
                    data: [@data.activeJobs, @data.expiredJobs],
                    backgroundColor: ['#2196f3', '#9e9e9e']
                }]
            }
        });
    </script>
}
