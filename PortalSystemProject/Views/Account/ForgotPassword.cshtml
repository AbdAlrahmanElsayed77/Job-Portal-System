@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-key display-3 text-warning"></i>
                        <h3 class="fw-bold mt-3">Forgot Password?</h3>
                        <p class="text-muted">Enter your email to reset your password</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        @if (ViewBag.Message != null)
                        {
                            <div class="alert alert-info" role="alert">
                                @ViewBag.Message
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-envelope"></i> Email Address
                            </label>
                            <input type="email" name="email" class="form-control form-control-lg rounded-3"
                                   placeholder="Enter your email" required />
                        </div>

                        <button type="submit" class="btn btn-warning btn-lg w-100 rounded-3 mb-3">
                            <i class="bi bi-send"></i> Send Reset Link
                        </button>

                        <div class="text-center">
                            <a asp-action="Login" class="text-decoration-none">
                                <i class="bi bi-arrow-left"></i> Back to Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
