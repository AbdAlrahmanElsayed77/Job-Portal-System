@using Domains
@model BL.Dtos.Common.PagedResultDto<Domains.JobPost>

@{
    ViewData["Title"] = "Jobs in " + ViewBag.CategoryName;
}

<h1>Jobs in @ViewBag.CategoryName</h1>



<div class="m-4"> <button type="button" class="btn btn-outline-secondary d-flex align-items-center gap-2" onclick="window.history.back();"> 
    <i class="fas fa-arrow-left"></i> <span>Back</span> </button> </div>
<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Company</th>
            <th>Location</th>
            <th>Min Salary</th>
            <th>Max Salary</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model.Items)
        {
            <tr>
                <td>@job.Title</td>
                <td>@job.Company?.Name</td>
                <td>@($"{job.City}, {job.Country}")</td>
                <td>@job.MinSalary</td>
                <td>@job.MaxSalary</td>
            </tr>
        }
    </tbody>
</table>
@await Html.PartialAsync("_Pagination", Model)
