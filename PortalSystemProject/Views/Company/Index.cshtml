@model List<Domains.Company>

@{
    ViewData["Title"] = "Browse Companies";
}

<div class="container mt-4 mb-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-lg-8">
            <h2 class="fw-bold">
                <i class="bi bi-building"></i> Browse Companies
            </h2>
            <p class="text-muted">Discover companies hiring on our platform</p>
        </div>
        <div class="col-lg-4">
            <!-- Search -->
            <form method="get" asp-action="Index">
                <div class="input-group">
                    <input type="text" name="search" class="form-control"
                           placeholder="Search companies..."
                           value="@ViewBag.SearchTerm" />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-building display-1 text-muted"></i>
            <h4 class="mt-3">No Companies Found</h4>
            <p class="text-muted">
                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                {
                    <span>No companies match your search. <a asp-action="Index">View all companies</a></span>
                }
                else
                {
                    <span>There are no companies registered yet.</span>
                }
            </p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var company in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 company-card">
                        <div class="card-body p-4">
                            <!-- Logo -->
                            <div class="text-center mb-3">
                                <img src="@(company.LogoUrl ?? "/img/default-company-logo.png")"
                                     alt="@company.Name Logo"
                                     class="img-thumbnail border-0"
                                     style="width: 80px; height: 80px; object-fit: contain; background: #f8f9fa;" />
                            </div>

                            <!-- Company Name -->
                            <h5 class="fw-bold text-center mb-2">@company.Name</h5>

                            <!-- Location -->
                            @if (!string.IsNullOrEmpty(company.City) || !string.IsNullOrEmpty(company.Country))
                            {
                                <p class="text-muted text-center small mb-3">
                                    <i class="bi bi-geo-alt"></i>
                                    @company.City@(string.IsNullOrEmpty(company.City) ? "" : ", ")@company.Country
                                </p>
                            }

                        <!-- Description -->
                        <p class="text-muted small mb-3" style="height: 60px; overflow: hidden;">
                            @(company.Description?.Length > 100
                                                    ? company.Description.Substring(0, 100) + "..."
                                                    : company.Description ?? "No description available")
                    </p>

                            <!-- Website -->
                    @if (!string.IsNullOrEmpty(company.Website))
                            {
                                <div class="mb-3">
                                    <a href="@company.Website" target="_blank" class="text-decoration-none small">
                                        <i class="bi bi-globe"></i> Visit Website
                                    </a>
                                </div>
                            }

                            <!-- Action Button -->
                            <a asp-action="Details" asp-route-id="@company.Id" class="btn btn-primary w-100">
                                <i class="bi bi-eye"></i> View Company
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination info -->
        <div class="text-center mt-4">
            <p class="text-muted">Showing @Model.Count companies</p>
        </div>
    }
</div>

@section Styles {
    <style>
        .company-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .company-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
            }
    </style>
}