@model PortalSystemProject.Models.Admin.JobTypeListViewModel

@{
    ViewData["Title"] = "Job Types";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0">Job Types</h4>
        <p class="text-muted">Manage job types (Full-time, Part-time, etc.)</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Job Type
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Jobs Count</th>
                        <th>Created At</th>
                        <th width="150">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.JobTypes.Any())
                    {
                        @foreach (var jobType in Model.JobTypes)
                        {
                            <tr>
                                <td><strong>@jobType.Name</strong></td>
                                <td>
                                    <span class="badge bg-success">@jobType.JobCount Jobs</span>
                                </td>
                                <td>@jobType.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@jobType.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger delete-btn"
                                                data-id="@jobType.Id"
                                                data-name="@jobType.Name"
                                                @(jobType.JobCount > 0 ? "disabled" : "")>
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4">
                                <i class="bi bi-inbox fs-1 text-muted"></i>
                                <p class="text-muted">No job types found</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.dataset.id;
                const name = this.dataset.name;

                if (!confirm(`Delete "${name}"?`)) return;

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                const response = await fetch(`/Admin/JobType/Delete/${id}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });

                const result = await response.json();
                if (result.success) location.reload();
                else alert(result.message);
            });
        });
    </script>
}