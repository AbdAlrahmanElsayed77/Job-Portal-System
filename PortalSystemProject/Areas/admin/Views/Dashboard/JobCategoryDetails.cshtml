@model Domains.JobCategory
@{
    ViewData["Title"] = "Category Details";
}

<h2>Category Details</h2>

<div class="card p-4 shadow-sm">
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Created Date</dt>
        <dd class="col-sm-9">@Model.CreatedDate.ToString()</dd>

        <dt class="col-sm-3">Jobs in this Category</dt>
        <dd class="col-sm-9">
            @if (Model.JobPosts.Any())
            {
                <ul>
                    @foreach (var job in Model.JobPosts)
                    {
                        <li>@job.Title (@job.Company?.Name)</li>
                    }
                </ul>
            }
            else
            {
                <span>No jobs available.</span>
            }
        </dd>
    </dl>

    <a asp-action="Industries" class="btn btn-secondary">Back to List</a>
</div>
