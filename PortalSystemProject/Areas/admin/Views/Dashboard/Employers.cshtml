@using Domains
@model BL.Dtos.Common.PagedResultDto<Domains.EmployerProfile>

@{
    ViewData["Title"] = "Employers";
}

<h1>Employers</h1>

<table class="table table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Contact Email</th>
            <th>Company</th>
            @* <th>Status</th> *@
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employer in Model.Items)
        {
            <tr id="row-@employer.Id">
                <td>@employer.User.UserName</td>
                <td>@employer.User.Email</td>
                <td>@employer.Company?.Name</td>
                @* <td>
                    <select class="form-select form-select-sm status-select" data-id="@employer.Id" style="min-width: 140px;">
                        <option value="Pending" @(employer.Status == EmployerStatus.Pending ? "selected" : "")>Pending</option>
                        <option value="Approved" @(employer.Status == EmployerStatus.Approved ? "selected" : "")>Approved</option>
                        <option value="Rejected" @(employer.Status == EmployerStatus.Rejected ? "selected" : "")>Rejected</option>
                    </select>
                </td> *@
                <td>
                    <a asp-area="admin" asp-controller="Dashboard" asp-action="Details" asp-route-id="@employer.Id" class="btn btn-info btn-sm">Details</a>
                </td>
               

            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pagination", Model)

@section Scripts {
    <script>
        document.querySelectorAll(".status-select").forEach(select => {
            select.addEventListener("change", async (e) => {
                const employerId = e.target.getAttribute("data-id");
                const newStatus = e.target.value;

                try {
                    const response = await fetch(`/admin/Dashboard/UpdateEmployerStatus`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                        },
                        body: JSON.stringify({ id: employerId, status: newStatus })
                    });

                    if (response.ok) {
                        const message = await response.text();
                        alert(message || "Status updated successfully ✅");
                    } else {
                        alert("❌ Failed to update status");
                    }
                } catch (err) {
                    console.error(err);
                    alert("⚠️ Error connecting to server");
                }
            });
        });
    </script>
}
