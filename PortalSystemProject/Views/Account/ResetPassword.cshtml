<h2>Reset Password</h2>
<form asp-action="ResetPassword" method="post">
    <input type="hidden" name="email" value="@ViewBag.Email" />
    <input type="hidden" name="token" value="@ViewBag.Token" />
    <label>New Password</label>
    <input name="newPassword" type="password" class="form-control" />
    <label>Confirm New Password</label>
    <input name="confirmNewPassword" type="password" class="form-control" />
    <button type="submit" class="btn btn-primary mt-2">Reset</button>
</form>
@if (ViewBag.Message != null)
{
    <p class="alert alert-info mt-3 text-center fw-bold">@ViewBag.Message</p>
}
<a asp-action="Login">Back to Login</a>