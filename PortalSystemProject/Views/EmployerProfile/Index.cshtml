@model BL.Dtos.EmployerProfileDto
@{
    ViewData["Title"] = "My Employer Profile";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold text-primary mb-0">
                    <i class="bi bi-person-badge"></i> Employer Profile
                </h3>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-square"></i> Edit Profile
                </a>
            </div>
            <!-- ✅ Company Logo Section -->
            @if (!string.IsNullOrEmpty(Model.CompanyLogoUrl))
            {
                <div class="text-center mb-4">
                    <img src="@Model.CompanyLogoUrl"
                         alt="Company Logo"
                         class="img-fluid rounded-circle shadow-sm border"
                         style="width: 150px; height: 150px; object-fit: cover;">
                    <div class="mt-2 text-muted">@Model.CompanyName</div>
                </div>
            }
            else
            {
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto shadow-sm border"
                         style="width: 150px; height: 150px;">
                        <i class="bi bi-building text-secondary" style="font-size: 3rem;"></i>
                    </div>
                    <div class="mt-2 text-muted">No Logo Uploaded</div>
                </div>
            }
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 shadow-sm h-100">
                        <h6 class="text-muted text-uppercase mb-2">Company Info</h6>
                        <p><strong>Company:</strong> @Model.CompanyName</p>
                        <p><strong>Job Title:</strong> @Model.JobTitle</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 shadow-sm h-100">
                        <h6 class="text-muted text-uppercase mb-2">Account Info</h6>
                        <p><strong>User ID:</strong> @Model.UserId</p>
                        <p><strong>Created At:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
