@using Domains
@model BL.Dtos.Common.PagedResultDto<Domains.Company>

@{
    var title = "Companies";
}

<h1>@title</h1>

<table class="table">
   
   
    <thead>
        <tr>
            <th>Name</th>
            <th>Website</th>
            <th>Country</th>
            <th>City</th>
            <th>Jobs Count</th>
        </tr>
        </thead>
    <tbody>
        @foreach (var company in Model.Items)
        {
            <tr>
                <td>@company.Name</td>
                <td>
                    @if (!string.IsNullOrEmpty(company.Website))
                    {
                        <a href="@company.Website" target="_blank">@company.Website</a>
                    }
                </td>
                <td>@company.Country</td>
                <td>@company.City</td>
                <td>@company.JobPosts.Count</td>
            </tr>
        }
        </tbody>


</table>
@await Html.PartialAsync("_Pagination", Model)
