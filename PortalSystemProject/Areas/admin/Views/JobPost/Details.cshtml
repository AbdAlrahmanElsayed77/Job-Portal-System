@model PortalSystemProject.Models.Admin.JobPostDetailsViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Job Post Details";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">@Model.Title</h4>
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </div>

        <div class="card-body">
            <div class="row">
                <!-- Company Details -->
                <div class="col-md-4 text-center border-end">
                    <img src="@Model.CompanyLogoUrl" class="img-fluid rounded mb-2" alt="@Model.CompanyName" style="max-height: 100px;" />
                    <h5 class="fw-bold">@Model.CompanyName</h5>
                    @if (!string.IsNullOrEmpty(Model.CompanyWebsite))
                    {
                        <p>
                            <a href="@Model.CompanyWebsite" target="_blank" class="text-decoration-none">
                                <i class="bi bi-globe"></i> @Model.CompanyWebsite
                            </a>
                        </p>
                    }
                    <hr />
                    <p><strong>Category:</strong> @Model.CategoryName</p>
                    <p><strong>Type:</strong> @Model.JobTypeName</p>
                    <p><strong>Location:</strong> @Model.Location</p>
                    @if (Model.ExpiryDate.HasValue)
                    {
                        <p><strong>Expiry Date:</strong> @Model.ExpiryDate?.ToString("yyyy-MM-dd")</p>
                    }
                </div>

                <!-- Job Details -->
                <div class="col-md-8">
                    <h5 class="text-primary mb-3">Description</h5>
                    <p>@Html.Raw(Model.Description)</p>

                    @if (!string.IsNullOrEmpty(Model.Requirements))
                    {
                        <h5 class="text-primary mt-4">Requirements</h5>
                        <p>@Html.Raw(Model.Requirements)</p>
                    }

                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p>
                                <strong>Salary Range:</strong>
                                @if (Model.MinSalary.HasValue || Model.MaxSalary.HasValue)
                                {
                                    @($"{Model.MinSalary?.ToString("N0")} - {Model.MaxSalary?.ToString("N0")}")
                                }
                                else
                                {
                                    @("Not specified")
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Posted Date:</strong> @Model.PostedDate.ToString("yyyy-MM-dd")</p>
                        </div>
                    </div>

                    <hr />

                    <!-- Application Stats -->
                    <h5 class="text-primary">Applications Summary</h5>
                    <table class="table table-sm table-bordered align-middle">
                        <tbody>
                            <tr>
                                <th>Total Applications</th>
                                <td>@Model.TotalApplications</td>
                            </tr>
                            <tr>
                                <th>Pending</th>
                                <td>@Model.PendingApplications</td>
                            </tr>
                            <tr>
                                <th>Accepted</th>
                                <td>@Model.AcceptedApplications</td>
                            </tr>
                            <tr>
                                <th>Rejected</th>
                                <td>@Model.RejectedApplications</td>
                            </tr>
                        </tbody>
                    </table>

                    <hr />

                    <p><strong>Posted By:</strong> @Model.PostedBy</p>

                    <div class="mt-3 d-flex justify-content-between">
                        <a asp-area="Admin" asp-controller="JobPost" asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>

                        <div>
                            <form asp-area="Admin" asp-controller="JobPost" asp-action="ToggleStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn @(Model.IsActive ? "btn-warning" : "btn-success")">
                                    @(Model.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>


                            <form asp-area="Admin" asp-controller="JobPost" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this job post?');">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
