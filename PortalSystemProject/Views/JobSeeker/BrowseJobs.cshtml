@model PortalSystemProject.Models.JobSeeker.JobListViewModel

@{
    ViewData["Title"] = "Browse Jobs";
}
@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
}

<div class="container mt-4">
    <div class="row">
        <!-- Sidebar - Filters -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-filter"></i> Filter Results
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="BrowseJobs" method="get" id="filterForm">
                        <!-- Search -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Search Keyword</label>
                            <input type="text" class="form-control" name="search"
                                   value="@Model.Filters.SearchKeyword"
                                   placeholder="Search for a job...">
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category</label>
                            <select class="form-select" name="categoryId">
                                <option value="">All Categories</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id"
                                            selected="@(Model.Filters.CategoryId == cat.Id)">
                                        @cat.Name (@cat.JobCount)
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Job Type -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Job Type</label>
                            <select class="form-select" name="jobTypeId">
                                <option value="">All Types</option>
                                @foreach (var type in Model.JobTypes)
                                {
                                    <option value="@type.Id"
                                            selected="@(Model.Filters.JobTypeId == type.Id)">
                                        @type.Name (@type.JobCount)
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Country -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Country</label>
                            <select class="form-select" name="country" id="countrySelect">
                                <option value="">All Countries</option>
                                @foreach (var country in Model.Countries)
                                {
                                    <option value="@country"
                                            selected="@(Model.Filters.Country == country)">
                                        @country
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- City -->
                        @if (!string.IsNullOrEmpty(Model.Filters.Country))
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">City</label>
                                <select class="form-select" name="city">
                                    <option value="">All Cities</option>
                                    @foreach (var city in Model.Cities)
                                    {
                                        <option value="@city"
                                                selected="@(Model.Filters.City == city)">
                                            @city
                                        </option>
                                    }
                                </select>
                            </div>
                        }

                        <!-- Salary Range -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Salary Range</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" class="form-control" name="minSalary"
                                           value="@Model.Filters.MinSalary" placeholder="From">
                                </div>
                                <div class="col-6">
                                    <input type="number" class="form-control" name="maxSalary"
                                           value="@Model.Filters.MaxSalary" placeholder="To">
                                </div>
                            </div>
                        </div>

                        <!-- Experience -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Years of Experience</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" class="form-control" name="minExp"
                                           value="@Model.Filters.MinExperience" placeholder="From">
                                </div>
                                <div class="col-6">
                                    <input type="number" class="form-control" name="maxExp"
                                           value="@Model.Filters.MaxExperience" placeholder="To">
                                </div>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            <i class="fas fa-search"></i> Search
                        </button>
                        <a href="@Url.Action("BrowseJobs")" class="btn btn-outline-secondary w-100">
                            <i class="fas fa-redo"></i> Reset
                        </a>
                    </form>
                </div>
            </div>
        </div>

        <!-- Main Content - Job List -->
        <div class="col-md-9">
            <!-- Header with Sorting -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>
                    Found <span class="text-primary">@Model.TotalJobs</span> jobs
                </h4>
                <div class="d-flex align-items-center gap-2">
                    <label class="mb-0">Sort by:</label>
                    <select class="form-select form-select-sm" name="sortBy"
                            onchange="applySorting(this.value)" style="width: auto;">
                        <option value="recent" selected="@(Model.Filters.SortBy == "recent")">Most Recent</option>
                        <option value="salary" selected="@(Model.Filters.SortBy == "salary")">Salary</option>
                        <option value="experience" selected="@(Model.Filters.SortBy == "experience")">Experience</option>
                        <option value="title" selected="@(Model.Filters.SortBy == "title")">Title</option>
                    </select>
                </div>
            </div>

            <!-- Job List -->
            @if (Model.Jobs.Any())
            {
                foreach (var job in Model.Jobs)
                {
                    <div class="card mb-3 shadow-sm job-card">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-2 text-center">
                                    @if (!string.IsNullOrEmpty(job.CompanyLogo))
                                    {
                                        <img src="@job.CompanyLogo" alt="@job.CompanyName"
                                             class="img-fluid rounded" style="max-height: 80px;">
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                             style="height: 80px;">
                                            <i class="fas fa-building fa-3x text-muted"></i>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-8">
                                    <h5 class="card-title mb-2">
                                        <a asp-action="JobDetails" asp-route-id="@job.Id"
                                           class="text-decoration-none text-dark">
                                            @job.Title
                                        </a>
                                    </h5>
                                    <p class="text-muted mb-2">
                                        <i class="fas fa-building"></i> @job.CompanyName
                                    </p>
                                    <div class="d-flex flex-wrap gap-3 mb-2">
                                        @if (!string.IsNullOrEmpty(job.City))
                                        {
                                            <small>
                                                <i class="fas fa-map-marker-alt text-primary"></i>
                                                @job.City, @job.Country
                                            </small>
                                        }
                                        @if (!string.IsNullOrEmpty(job.SalaryRange))
                                        {
                                            <small>
                                                <i class="fas fa-money-bill-wave text-success"></i>
                                                @job.SalaryRange
                                            </small>
                                        }
                                        @if (!string.IsNullOrEmpty(job.ExperienceRange))
                                        {
                                            <small>
                                                <i class="fas fa-briefcase text-info"></i>
                                                @job.ExperienceRange
                                            </small>
                                        }
                                    </div>
                                    <div>
                                        <span class="badge bg-primary">@job.JobCategory</span>
                                        @if (!string.IsNullOrEmpty(job.JobType))
                                        {
                                            <span class="badge bg-secondary">@job.JobType</span>
                                        }
                                        @if (job.HasApplied)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check"></i> Applied
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-2 text-end">
                                    <small class="text-muted d-block mb-3">
                                        @job.PublishedAt.ToString("dd/MM/yyyy")
                                    </small>

                                    @if (User.Identity!.IsAuthenticated)
                                    {
                                        <button class="btn btn-sm btn-outline-danger save-btn mb-2"
                                                data-job-id="@job.Id"
                                                data-is-saved="@job.IsSaved.ToString().ToLower()">
                                            <i class="@(job.IsSaved ? "fas" : "far") fa-heart"></i>
                                        </button>
                                    }

                                    <a asp-action="JobDetails" asp-route-id="@job.Id"
                                       class="btn btn-sm btn-primary w-100">
                                        Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@GetPageUrl(Model.CurrentPage - 1)">Previous</a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@GetPageUrl(i)">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@GetPageUrl(Model.CurrentPage + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle fa-3x mb-3"></i>
                    <h5>No jobs available</h5>
                    <p>Try adjusting your search criteria</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sorting
        function applySorting(sortBy) {
            const url = new URL(window.location.href);
            url.searchParams.set('sortBy', sortBy);
            url.searchParams.set('page', '1');
            window.location.href = url.toString();
        }

        // ✅ Save/Unsave Job - FIXED
        document.querySelectorAll('.save-btn').forEach(btn => {
            btn.addEventListener('click', async function(e) {
                e.preventDefault();

                const jobId = this.dataset.jobId;
                const formData = new FormData();
                formData.append('__RequestVerificationToken',
                    '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1]);

                try {
                    const response = await fetch(`/SavedJobs/Toggle?jobId=${jobId}`, {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        const icon = this.querySelector('i');
                        if (result.action === 'saved') {
                            icon.classList.remove('far');
                            icon.classList.add('fas');
                            this.dataset.isSaved = 'true';
                        } else {
                            icon.classList.remove('fas');
                            icon.classList.add('far');
                            this.dataset.isSaved = 'false';
                        }
                    } else {
                        alert(result.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('An error occurred. Please try again.');
                }
            });
        });

        // Auto-submit when country changes
        document.getElementById('countrySelect')?.addEventListener('change', function() {
            if (this.value) {
                document.getElementById('filterForm').submit();
            }
        });
    </script>
}
@functions {
    string GetPageUrl(int page)
    {
        var routeValues = new RouteValueDictionary
        {
            { "page", page },
            { "search", Model.Filters.SearchKeyword },
            { "categoryId", Model.Filters.CategoryId },
            { "jobTypeId", Model.Filters.JobTypeId },
            { "country", Model.Filters.Country },
            { "city", Model.Filters.City },
            { "minSalary", Model.Filters.MinSalary },
            { "maxSalary", Model.Filters.MaxSalary },
            { "minExp", Model.Filters.MinExperience },
            { "maxExp", Model.Filters.MaxExperience },
            { "sortBy", Model.Filters.SortBy }
        };
        return Url.Action("BrowseJobs", routeValues) ?? "#";
    }
}
