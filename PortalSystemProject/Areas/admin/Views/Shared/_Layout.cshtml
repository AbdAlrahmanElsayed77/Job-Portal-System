<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            display: flex;
            min-height: 100vh;
            margin: 0;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            background-color: #212529;
            color: #fff;
            position: fixed;
            top: 0;
            bottom: 0;
            padding: 1.5rem 1rem;
        }

            .sidebar .brand {
                font-size: 1.3rem;
                font-weight: bold;
                color: #ffc107;
                text-align: center;
                margin-bottom: 2rem;
                display: block;
                text-decoration: none;
            }

            .sidebar .nav-link {
                color: #adb5bd;
                display: block;
                padding: 0.7rem 1rem;
                border-radius: 8px;
                margin-bottom: 0.5rem;
                transition: 0.2s;
            }

                .sidebar .nav-link:hover,
                .sidebar .nav-link.active {
                    background-color: #343a40;
                    color: #ffc107;
                }

        /* Content area */
        .content {
            margin-left: 250px;
            flex-grow: 1;
            padding: 2rem;
        }

        /* Footer */
        footer {
            position: fixed;
            bottom: 0;
            left: 250px;
            right: 0;
            background-color: #212529;
            color: #adb5bd;
            text-align: center;
            padding: 0.8rem;
        }

        /* Charts & Cards */
        canvas {
            width: 100% !important;
            height: 300px !important;
        }

        .card {
            border-radius: 12px;
            border: none;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
        }

        /* Responsive */
        media (max-width: 992px) {
            .sidebar

        {
            width: 200px;
        }

        .content {
            margin-left: 200px;
            padding: 1.2rem;
        }

        }

        media (max-width: 768px) {
            .sidebar

        {
            position: static;
            width: 100%;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
        }

        .content {
            margin: 0;
        }

        footer {
            left: 0;
        }

        }
    </style>
</head>

<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <a href="@Url.Action("Index", "Dashboard", new { area = "admin" })" class="brand">Admin Portal</a>

        <nav>
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Employers" ? "active" : "")"
               href="@Url.Action("Employers", "Dashboard", new { area = "admin" })">Employers</a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Jobs" ? "active" : "")"
               href="@Url.Action("Jobs", "Dashboard", new { area = "admin" })">Jobs</a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Companies" ? "active" : "")"
               href="@Url.Action("Companies", "Dashboard", new { area = "admin" })">Companies</a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Industries" ? "active" : "")"
               href="@Url.Action("Industries", "Dashboard", new { area = "admin" })">Categories</a>

            <a class="nav-link" href="/">Home</a>
        </nav>
    </div>

    <!-- Main Content -->
    <main class="content">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer>
        <p class="mb-0">© @DateTime.Now.Year Job Portal Admin Dashboard</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>

