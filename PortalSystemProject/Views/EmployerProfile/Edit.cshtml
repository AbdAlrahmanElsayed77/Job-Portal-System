@model BL.Dtos.EmployerProfileDto

<div class="container mt-5">
    @* Success/Error Messages *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm p-4 rounded-4">
        <h4 class="fw-bold mb-4">Edit Employer Profile</h4>
        <form asp-action="Edit" asp-controller="EmployerProfile" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="CompanyId" />

            <div class="mb-3">
                <label asp-for="JobTitle" class="form-label">Job Title</label>
                <input asp-for="JobTitle" class="form-control rounded-3" placeholder="e.g. HR Manager, Recruiter" />
                <span asp-validation-for="JobTitle" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.CompanyLogoUrl))
            {
                <div class="mb-3">
                    <label class="form-label">Current Company Logo</label>
                    <div>
                        <img src="@Model.CompanyLogoUrl" alt="Company Logo" class="img-thumbnail" style="max-width: 150px; max-height: 150px;" />
                    </div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Company Logo</label>
                <input type="file" name="logoFile" class="form-control rounded-3" accept="image/*" />
                <small class="text-muted">Leave empty to keep current logo</small>
            </div>

            @if (!string.IsNullOrEmpty(Model.CompanyName))
            {
                <div class="mb-3">
                    <label class="form-label">Company</label>
                    <input type="text" value="@Model.CompanyName" class="form-control rounded-3" disabled readonly />
                    <small class="text-muted">Company cannot be changed after creation</small>
                </div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-3">
                    <i class="bi bi-save"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-secondary rounded-3">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}