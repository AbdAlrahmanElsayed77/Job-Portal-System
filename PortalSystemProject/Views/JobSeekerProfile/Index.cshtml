@model BL.Dtos.JobSeekerProfileDto

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-3 text-center">
                    <img src="@(Model.PhotoUrl ?? " /img/default-avatar.png")"
                         alt="Profile Photo"
                         class="rounded-circle img-thumbnail shadow-sm"
                         style="width: 150px; height: 150px; object-fit: cover;">
                    <div class="mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil"></i> Edit Profile
                        </a>
                    </div>
                </div>

                <div class="col-md-9">
                    <h3 class="fw-bold mb-1">@Model.Headline</h3>
                    <p class="text-muted mb-2">
                        <i class="bi bi-geo-alt"></i> @Model.City, @Model.Country
                    </p>
                    <p class="text-muted small">
                        Member since @Model.CreatedAt.ToString("MMMM yyyy")
                    </p>
                    <hr>
                    <p>@Model.Summary</p>
                </div>
            </div>

            <hr class="my-4">

            <div>
                <h5 class="fw-bold mb-3">Uploaded CVs</h5>
                @if (Model.CVFiles?.Count > 0)
                {
                    <ul class="list-group">
                        @foreach (var cv in Model.CVFiles)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-file-earmark-text"></i>
                                    @cv.FileName
                                    <small class="text-muted">(@(cv.FileSizeBytes / 1024) KB)</small>
                                </div>
                                <a href="@cv.BlobUrl" target="_blank" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-download"></i> View
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-muted fst-italic">No CV uploaded yet.</div>
                }
            </div>
        </div>
    </div>
</div>
